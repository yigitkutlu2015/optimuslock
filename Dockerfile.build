# Pardus 23 (Debian 12 "bookworm") ile uyumlu Linux ikilisi üretir.
FROM python:3.11-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils libgl1 libegl1 libxkbcommon0 libxkbcommon-x11-0 libxcb-cursor0 \
    libdbus-1-3 libfontconfig1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pyinstaller
COPY *.py ./
RUN pyinstaller --noconfirm --onefile --windowed --name optimuslock optimuslock.py
CMD ["cp", "/src/dist/optimuslock", "/out/optimuslock"]
